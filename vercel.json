{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/s/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/post/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|facebook|zalo|Twitterbot|TelegramBot|Slackbot|WhatsApp|LinkedInBot|Pinterest|Discordbot|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
